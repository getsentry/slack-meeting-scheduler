{
  "display_information": {
    "name": "Meeting Scheduler",
    "description": "Schedule Google Meet meetings with reaction-based attendance tracking",
    "background_color": "#2c2d30"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true
    },
    "bot_user": {
      "display_name": "Meeting Scheduler",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/schedule-meet",
        "description": "Schedule a meeting with reaction-based attendance",
        "usage_hint": "[reaction-time] [specific-time] [options]"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "reactions:read",
        "reactions:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
