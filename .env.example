# Slack Configuration (not needed for CLI mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Google Configuration
# Optional: Only needed for local development
# When deployed to Cloud Run, the service account identity is used automatically
# Path to service account JSON file
# GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# OR provide JSON content directly (use one or the other)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Meeting Defaults
DEFAULT_MEETING_DURATION=60
MIN_REACTIONS=2
DEFAULT_REACTION_EMOJI=white_check_mark

# Business Hours (24-hour format HH:MM)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00

# Availability Search Settings
MAX_DAYS_AHEAD=14

# Application Settings
LOG_LEVEL=INFO

# Sentry Configuration (optional)
# Get your DSN from https://sentry.io/settings/projects/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
